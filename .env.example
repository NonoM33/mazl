# MAZL Environment Variables
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mazl
RESEND_API_KEY=your_resend_api_key
APP_URL=http://localhost:3000
PORT=3000
ADMIN_PASSWORD=your_admin_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# Development routes (/api/dev/*) only exist with development or test.
NODE_ENV=development

# JWT secrets (32+ random bytes each, different from each other)
JWT_SECRET=your_super_secret_jwt_key
ADMIN_JWT_SECRET=another_random_secret

# Proxies in front of the server that append to X-Forwarded-For (Coolify's
# Traefik: 1). 0 when the server is exposed directly.
TRUSTED_PROXY_HOPS=1

# Web client (app.mazl.app, docs/web/adr/W01-W03). Without WEB_ORIGIN the
# client is served under /app of any host (development).
WEB_ORIGIN=https://app.mazl.app
# Sign in with Apple on the web: the Services ID created in the Apple
# developer account (empty: the Apple button is hidden).
APPLE_WEB_SERVICES_ID=
# Proof of work asked at web sign-in, in bits (default 18; 0 refused in production).
WEB_POW_DIFFICULTY=18

# Stripe, TEST mode (docs/web/adr/W04-stripe.md). Without the secret key the
# web payment routes answer 503 and the site says payments are not open yet.
# A live key (sk_live_) stops the boot unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PLUS_1M=price_xxx
STRIPE_PRICE_PLUS_3M=price_xxx
STRIPE_PRICE_PLUS_6M=price_xxx
STRIPE_PRICE_PLUS_12M=price_xxx
STRIPE_PRICE_BOOST_1=price_xxx
STRIPE_PRICE_BOOST_3=price_xxx
STRIPE_PRICE_SUPERLIKES_5=price_xxx
STRIPE_PRICE_SUPERLIKES_15=price_xxx

# Website container (web/Dockerfile, docs/deploy/README.md). On the API:
# SERVE_WEBSITE=false stops it serving the website (client, landing, legal pages);
# unset, it serves them as before. On the website container: API_UPSTREAM (the API
# on the internal network), WEB_ORIGIN, PUBLIC_BASE_URL (the API host) and, optional,
# TRUSTED_PROXIES.
SERVE_WEBSITE=true

# Sign in with Apple, revocation at account deletion (App Store rule 5.1.1(v)).
# A Sign in with Apple key (.p8) of the Apple developer account. Without all
# three, signing in works and the revocation is skipped (a warning at boot).
# The key is a PEM; on one line, write the line breaks as \n.
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
