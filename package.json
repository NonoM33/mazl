{
  "name": "mazl",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun scripts/test-integration.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p console/tsconfig.json && tsc --noEmit -p landing/tsconfig.json",
    "console:mock": "bun console/dev/mock-api.ts",
    "console:screenshots": "bun console/dev/screenshots.ts",
    "web:build": "bun web/build.ts",
    "web:watch": "NODE_ENV=development bun build ./web/index.html --outdir ./web/dist --public-path /app/ --external '/app/fonts/*' --watch",
    "web:check": "tsc --noEmit -p web/tsconfig.json && eslint --max-warnings 0 web/src",
    "test:web": "bun test tests/web-client",
    "test:e2e": "bun tests/e2e/run.ts",
    "models:fetch": "bun scripts/fetch-face-models.ts",
    "landing:build": "bun landing/build.ts",
    "landing:check": "tsc --noEmit -p landing/tsconfig.json",
    "legal:build": "bun scripts/legal/build.ts",
    "legal:check": "bun scripts/legal/build.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/luxon": "1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.62.0",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "kosher-zmanim": "^0.9.0",
    "lucide-react": "^1.61.0",
    "onnxruntime-node": "1.30.0",
    "postgres": "^3.4.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.7.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
